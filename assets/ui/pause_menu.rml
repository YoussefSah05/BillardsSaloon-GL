<rml>
<head>
    <title>Paused</title>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        body {
            z-index: 10;
            background-color: rgba(8, 9, 11, 120);
        }
        /* Blurs the table but leaves the scorebug readable. */
        .dim {
            position: absolute;
            left: 0;
            right: 0;
            top: 110dp;
            bottom: 0;
            backdrop-filter: blur(8dp);
        }
        .panel {
            position: absolute;
            left: 50%;
            top: 50%;
            width: 400dp;
            margin-left: -200dp;
            margin-top: -190dp;
        }
        .panel h2 {
            margin-bottom: 18dp;
            font-weight: 800;
            font-size: 46dp;
            letter-spacing: 2dp;
            text-align: center;
        }
        .hints {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 40dp;
            text-align: center;
        }
    </style>
</head>
<body class="screen" data-model="shell">
    <div class="dim"></div>
    <div class="panel">
        <h2>PAUSED</h2>
        <button class="menu-item" id="resume" autofocus data-event-click="resume"><span class="label">RESUME</span></button>
        <button class="menu-item" id="restart" data-event-click="restart_rack"><span class="label">RESTART RACK</span></button>
        <button class="menu-item" id="settings" data-event-click="open_settings"><span class="label">SETTINGS</span></button>
        <button class="menu-item" id="mainmenu" data-event-click="main_menu"><span class="label">MAIN MENU</span></button>
    </div>
    <div class="hints" data-visible="!gamepad">
        <span class="hint"><span class="key">UP / DOWN</span>Select</span>
        <span class="hint"><span class="key">ENTER</span>or click to confirm</span>
        <span class="hint"><span class="key">ESC</span>Resume</span>
    </div>
    <div class="hints" data-visible="gamepad">
        <span class="hint"><span class="key">D-PAD</span>Select</span>
        <span class="hint"><span class="key pad">A</span>Confirm</span>
        <span class="hint"><span class="key pad">B</span>Resume</span>
    </div>
</body>
</rml>
